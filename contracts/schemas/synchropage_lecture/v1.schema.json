{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/synchropage.lecture.v1.schema.json",
  "title": "SynchroPage Lecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "document",
    "pages"
  ],
  "properties": {
    "schema": {
      "const": "synchropage.lecture.v1"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "page_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source_pdf_url": {
          "type": "string"
        },
        "page_count": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "lesson_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "document_summary",
            "segments",
            "pages"
          ],
          "properties": {
            "version": {
              "type": "string",
              "const": "synchropage.lesson-plan.v1"
            },
            "model": {
              "type": "string"
            },
            "output_language": {
              "type": "string",
              "enum": [
                "zh-CN",
                "en-US"
              ]
            },
            "document_summary": {
              "type": "string"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "pages"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "title": {
                    "type": "string"
                  },
                  "goal": {
                    "type": "string"
                  },
                  "pages": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "page_no",
                  "segment",
                  "role",
                  "depth"
                ],
                "properties": {
                  "page_no": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "segment": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "title",
                      "agenda",
                      "transition",
                      "concept",
                      "derivation",
                      "example",
                      "exercise",
                      "recap",
                      "summary",
                      "blank"
                    ]
                  },
                  "depth": {
                    "type": "string",
                    "enum": [
                      "skim",
                      "brief",
                      "full"
                    ]
                  },
                  "key": {
                    "type": "boolean"
                  },
                  "cue": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "description": "Lesson plan written by the planning pass: segments, per-page role and depth."
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_no",
        "source",
        "teaching",
        "status"
      ],
      "properties": {
        "page_no": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pdf_page_ref",
            "text_md",
            "ocr_used",
            "parser"
          ],
          "properties": {
            "pdf_page_ref": {
              "type": "string"
            },
            "text_md": {
              "type": "string"
            },
            "ocr_used": {
              "type": "boolean"
            },
            "parser": {
              "type": "string"
            },
            "text_garbled": {
              "type": "boolean",
              "description": "The extracted text layer is unreadable (formulas drawn with an embedded font came out as stray symbols)."
            },
            "page_type": {
              "type": "string",
              "enum": [
                "title",
                "agenda",
                "concept",
                "example",
                "figure",
                "table",
                "formula",
                "exercise",
                "summary",
                "blank",
                "unknown"
              ]
            }
          }
        },
        "teaching": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slide_title",
            "speaker_notes_md",
            "concepts",
            "visual_explanations",
            "formula_explanations",
            "evidence",
            "confidence",
            "needs_review",
            "needs_parser_fallback"
          ],
          "properties": {
            "slide_title": {
              "type": "string"
            },
            "speaker_notes_md": {
              "type": "string"
            },
            "concepts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contextual_bridge": {
              "type": "string"
            },
            "visual_explanations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "formula_explanations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stuck_points": {
              "description": "Where a learner typically gets stuck on this page, each resolved in one line.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exam_angles": {
              "description": "How an exam would test this page: question forms, traps, what graders look for.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "generation_error": {
              "description": "Why the last generation attempt for this page failed (transport or quality). Written by the reader; absent on successful pages.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "timeout",
                    "rate_limit",
                    "network",
                    "invalid_json",
                    "truncated",
                    "server",
                    "quality"
                  ]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "at": {
                  "type": "number"
                }
              },
              "required": [
                "kind",
                "attempts",
                "at"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "quote_or_reference"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "title",
                      "keyword",
                      "formula",
                      "figure",
                      "table",
                      "caption",
                      "layout",
                      "other"
                    ]
                  },
                  "quote_or_reference": {
                    "type": "string"
                  }
                }
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "needs_review": {
              "type": "boolean"
            },
            "needs_parser_fallback": {
              "type": "boolean"
            },
            "handoff": {
              "type": "string",
              "description": "One or two sentences on what the student holds after this page; the next page's request receives it."
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "ready",
            "needs_review",
            "failed"
          ]
        }
      }
    }
  }
}
